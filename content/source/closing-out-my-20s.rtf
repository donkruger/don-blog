\f0\fs32 \cf2 \expnd0\expndtw0\kerning0
Closing out my 20s
\f1 \cf3 \
\pard\pardeftab720\partightenfactor0

\f0 \cf2 \'a0
\f1 \cf3 \
\pard\pardeftab720\qc\partightenfactor0

\f0 \cf2 Don Kruger 
